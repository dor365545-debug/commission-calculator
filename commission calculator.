<!DOCTYPE html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>הצהרת בריאות דיגיטלית</title>
    <style>
      :root {
        --primary: #162891;
        --primary-dark: #0f1d6f;
        --border: #d8dbe7;
        --text: #1f2a44;
        --muted: #6b7380;
        --bg: #f6f8fc;
        --card: #ffffff;
        --accent: #f5b433;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
        background: var(--bg);
        color: var(--text);
      }

      .page {
        max-width: 920px;
        margin: 0 auto;
        padding: 40px 20px 80px;
      }

      header {
        text-align: center;
        margin-bottom: 32px;
      }

      h1 {
        font-size: 32px;
        margin: 0 0 10px;
      }

      .subtitle {
        color: var(--muted);
        font-size: 16px;
        margin: 0;
      }

      .card {
        background: var(--card);
        border-radius: 18px;
        padding: 28px;
        box-shadow: 0 10px 20px rgba(15, 23, 42, 0.08);
      }

      .question {
        border-bottom: 1px solid var(--border);
        padding: 22px 0;
      }

      .question:last-child {
        border-bottom: none;
      }

      .question-title {
        font-weight: 600;
        margin-bottom: 18px;
        font-size: 18px;
      }

      .question-note {
        color: var(--muted);
        font-size: 14px;
        margin-top: -10px;
        margin-bottom: 14px;
      }

      .button-group {
        display: flex;
        gap: 12px;
      }

      .button-group input {
        display: none;
      }

      .button-group label {
        flex: 1;
        padding: 12px 18px;
        text-align: center;
        border-radius: 999px;
        border: 1px solid var(--border);
        cursor: pointer;
        font-weight: 600;
        background: #f0f2f9;
        color: var(--text);
        transition: all 0.2s ease;
      }

      .button-group input:checked + label {
        background: var(--primary);
        border-color: var(--primary);
        color: #fff;
        box-shadow: 0 4px 12px rgba(22, 40, 145, 0.25);
      }

      .followup {
        margin-top: 18px;
        padding: 16px;
        border-radius: 14px;
        background: #f3f5ff;
        border: 1px solid #dfe3f8;
      }

      .followup.hidden {
        display: none;
      }

      .checkbox-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 12px;
      }

      .checkbox-grid label {
        display: flex;
        gap: 8px;
        align-items: center;
        font-size: 15px;
      }

      textarea,
      input[type="text"] {
        width: 100%;
        padding: 12px;
        border-radius: 10px;
        border: 1px solid var(--border);
        font-size: 15px;
        margin-top: 10px;
        font-family: inherit;
      }

      .actions {
        display: flex;
        gap: 12px;
        justify-content: center;
        margin-top: 30px;
      }

      .actions button {
        border: none;
        padding: 12px 28px;
        border-radius: 999px;
        font-size: 16px;
        cursor: pointer;
        font-weight: 600;
      }

      .primary {
        background: var(--primary);
        color: #fff;
      }

      .secondary {
        background: #fff;
        color: var(--primary);
        border: 1px solid var(--primary);
      }

      .summary {
        margin-top: 28px;
        padding: 18px;
        border-radius: 14px;
        border: 1px solid var(--border);
        background: #fff;
      }

      .summary pre {
        white-space: pre-wrap;
        margin: 0;
        font-family: inherit;
        font-size: 14px;
        color: var(--text);
      }

      .tip {
        margin-top: 18px;
        font-size: 13px;
        color: var(--muted);
        text-align: center;
      }
    </style>
  </head>
  <body>
    <div class="page">
      <header>
        <h1>הצהרת בריאות דיגיטלית</h1>
        <p class="subtitle">
          הטופס הבא מאפשר לבחור תשובות כן/לא, לפתוח ענפים נוספים, ולהוסיף
          מלל חופשי לפי הצורך.
        </p>
      </header>

      <form id="health-form" class="card">
        <div class="question" data-question="q1">
          <div class="question-title">
            האם אחת ממטרות הנסיעה הייתה קבלת טיפול רפואי/אסתטי/קוסמטי?
          </div>
          <div class="button-group">
            <input id="q1-no" type="radio" name="q1" value="לא" />
            <label for="q1-no">לא</label>
            <input id="q1-yes" type="radio" name="q1" value="כן" />
            <label for="q1-yes">כן</label>
          </div>
          <div class="followup hidden" data-followup="q1">
            <label for="q1-details">פרטי טיפול ומיקום:</label>
            <textarea id="q1-details" name="q1-details" rows="3"></textarea>
          </div>
        </div>

        <div class="question" data-question="q2">
          <div class="question-title">
            האם במהלך 3 החודשים האחרונים אחד מהנוסעים פנה/הופנה לרופא לצורך
            ניתוח, אשפוז או מיון?
          </div>
          <div class="button-group">
            <input id="q2-no" type="radio" name="q2" value="לא" />
            <label for="q2-no">לא</label>
            <input id="q2-yes" type="radio" name="q2" value="כן" />
            <label for="q2-yes">כן</label>
          </div>
          <div class="followup hidden" data-followup="q2">
            <label for="q2-details">שם הנוסע וסיבת הפנייה:</label>
            <textarea id="q2-details" name="q2-details" rows="3"></textarea>
          </div>
        </div>

        <div class="question" data-question="q3">
          <div class="question-title">
            האם במהלך 3 החודשים האחרונים אחד מהנוסעים עבר בדיקות רפואיות או
            הומלץ לו לעבור בדיקה נוספת?
          </div>
          <p class="question-note">
            לדוגמה: US, CT, MRI, אקו לב, מיפוי לב, הולטר לב, בדיקות דם
            מיוחדות.
          </p>
          <div class="button-group">
            <input id="q3-no" type="radio" name="q3" value="לא" />
            <label for="q3-no">לא</label>
            <input id="q3-yes" type="radio" name="q3" value="כן" />
            <label for="q3-yes">כן</label>
          </div>
          <div class="followup hidden" data-followup="q3">
            <label for="q3-details">איזו בדיקה והיכן?</label>
            <textarea id="q3-details" name="q3-details" rows="3"></textarea>
          </div>
        </div>

        <div class="question" data-question="q4">
          <div class="question-title">
            האם מישהו מהנוסעים נוטל או נטל תרופות באופן קבוע?
          </div>
          <div class="button-group">
            <input id="q4-no" type="radio" name="q4" value="לא" />
            <label for="q4-no">לא</label>
            <input id="q4-yes" type="radio" name="q4" value="כן" />
            <label for="q4-yes">כן</label>
          </div>
          <div class="followup hidden" data-followup="q4">
            <p>עבור מי מהנוסעים נענתה תשובת "כן"?</p>
            <div class="checkbox-grid">
              <label><input type="checkbox" name="q4-person" value="כלל הנוסעים" />כלל הנוסעים</label>
              <label><input type="checkbox" name="q4-person" value="דנה שחר" />דנה שחר</label>
              <label><input type="checkbox" name="q4-person" value="רון וינמן" />רון וינמן</label>
              <label><input type="checkbox" name="q4-person" value="ליאור דוד וינמן" />ליאור דוד וינמן</label>
            </div>
            <label for="q4-details">פרטו תרופות ומינון:</label>
            <textarea id="q4-details" name="q4-details" rows="3"></textarea>
          </div>
        </div>

        <div class="question" data-question="q5">
          <div class="question-title">האם למישהו מהנוסעים בעיות בריאות?</div>
          <div class="button-group">
            <input id="q5-no" type="radio" name="q5" value="לא" />
            <label for="q5-no">לא</label>
            <input id="q5-yes" type="radio" name="q5" value="כן" />
            <label for="q5-yes">כן</label>
          </div>
          <div class="followup hidden" data-followup="q5">
            <p>בחרו את הבעיות הרלוונטיות:</p>
            <div class="checkbox-grid">
              <label><input type="checkbox" name="q5-condition" value="מחלת לב" />מחלת לב</label>
              <label><input type="checkbox" name="q5-condition" value="סוכרת" />סוכרת</label>
              <label><input type="checkbox" name="q5-condition" value="COPD" />COPD</label>
              <label><input type="checkbox" name="q5-condition" value="אסתמה" />אסתמה</label>
              <label><input type="checkbox" name="q5-condition" value="סרטן פעיל" />סרטן פעיל</label>
              <label><input type="checkbox" name="q5-condition" value="יתר לחץ דם" />יתר לחץ דם</label>
              <label><input type="checkbox" name="q5-condition" value="מחלה נוירולוגית" />מחלה נוירולוגית</label>
              <label><input type="checkbox" name="q5-condition" value="אחר" />אחר</label>
            </div>
            <label for="q5-details">פרטו מצב רפואי, תרופות ומעקב:</label>
            <textarea id="q5-details" name="q5-details" rows="3"></textarea>
          </div>
        </div>

        <div class="question" data-question="q6">
          <div class="question-title">
            האם מישהו מהנוסעים בהריון?
          </div>
          <div class="button-group">
            <input id="q6-no" type="radio" name="q6" value="לא" />
            <label for="q6-no">לא</label>
            <input id="q6-yes" type="radio" name="q6" value="כן" />
            <label for="q6-yes">כן</label>
          </div>
          <div class="followup hidden" data-followup="q6">
            <label for="q6-details">שבוע הריון ומעקב רפואי:</label>
            <textarea id="q6-details" name="q6-details" rows="2"></textarea>
          </div>
        </div>

        <div class="actions">
          <button class="secondary" type="reset">נקה טופס</button>
          <button class="primary" type="submit">שליחת ההצהרה</button>
        </div>
        <div class="tip">
          לאחר שליחה מתקבל סיכום שניתן להעתיק או לשלוח במייל.
        </div>
        <div class="summary" id="summary" hidden>
          <pre id="summary-output"></pre>
        </div>
      </form>
    </div>

    <script>
      const followupMap = new Map();
      document.querySelectorAll(".followup").forEach((section) => {
        followupMap.set(section.dataset.followup, section);
      });

      document.querySelectorAll("input[type='radio']").forEach((input) => {
        input.addEventListener("change", (event) => {
          const name = event.target.name;
          const followup = followupMap.get(name);
          if (!followup) return;
          followup.classList.toggle("hidden", event.target.value !== "כן");
        });
      });

      const form = document.getElementById("health-form");
      const summary = document.getElementById("summary");
      const summaryOutput = document.getElementById("summary-output");

      form.addEventListener("reset", () => {
        summary.hidden = true;
        summaryOutput.textContent = "";
        document.querySelectorAll(".followup").forEach((section) => {
          section.classList.add("hidden");
        });
      });

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        const data = new FormData(form);
        const lines = [];

        const pushAnswer = (label, value) => {
          if (value && value.trim() !== "") {
            lines.push(`${label}: ${value}`);
          }
        };

        pushAnswer("שאלה 1", data.get("q1"));
        pushAnswer("פרטי טיפול", data.get("q1-details"));

        pushAnswer("שאלה 2", data.get("q2"));
        pushAnswer("פרטי פנייה רפואית", data.get("q2-details"));

        pushAnswer("שאלה 3", data.get("q3"));
        pushAnswer("פרטי בדיקות", data.get("q3-details"));

        pushAnswer("שאלה 4", data.get("q4"));
        const q4People = data.getAll("q4-person");
        if (q4People.length) {
          lines.push(`נוסעים עם תרופות: ${q4People.join(", ")}`);
        }
        pushAnswer("תרופות ומינון", data.get("q4-details"));

        pushAnswer("שאלה 5", data.get("q5"));
        const q5Conditions = data.getAll("q5-condition");
        if (q5Conditions.length) {
          lines.push(`בעיות בריאות: ${q5Conditions.join(", ")}`);
        }
        pushAnswer("פירוט רפואי", data.get("q5-details"));

        pushAnswer("שאלה 6", data.get("q6"));
        pushAnswer("פרטי הריון", data.get("q6-details"));

        summaryOutput.textContent =
          lines.length > 0
            ? lines.join("\n")
            : "לא מולא מידע בטופס. אנא מלאו את השדות הרצויים.";
        summary.hidden = false;
        summary.scrollIntoView({ behavior: "smooth" });
      });
    </script>
  </body>
</html>
